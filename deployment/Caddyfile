{
	auto_https disable_redirects
	admin off
}
http://:8080 {
	log {
		output stdout
		format json
	}

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	request_body {
		max_size 1MB
	}

	root * ./dist

	# Maintenance mode: while ./dist/maintenance.flag exists, every request is
	# served the maintenance page with a 503 status. Toggle it live (no restart):
	#   enable:  docker exec -u www-data <container> touch /opt/app/dist/maintenance.flag
	#   disable: docker exec -u www-data <container> rm    /opt/app/dist/maintenance.flag
	@maintenance file /maintenance.flag
	handle @maintenance {
		rewrite * /maintenance.html
		file_server {
			status 503
		}
	}

	@backend path /dung /setaf /bipolar /rankings /adf /serialisation /paf /iaf
	handle @backend {
		rate_limit {
			zone tweety {
				key {remote_host}
				events 30
				window 1m
			}
		}
		# log_append proxy_target http://localhost:8081
		reverse_proxy http://localhost:8081
	}

	@graph-gen path /graph-gen/*
	handle @graph-gen {
		rate_limit {
			zone graph_gen {
				key {remote_host}
				events 20
				window 1m
			}
		}
		uri strip_prefix /graph-gen
		reverse_proxy http://localhost:8082
	}

	@shares path /shares /shares/*
	handle @shares {
		reverse_proxy http://localhost:8001
	}

	# Content-hashed build assets (Vite emits a hash in every filename) never
	# change once deployed, so they can be cached indefinitely.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# The index.html entry document (served here for every SPA route) must
		# be revalidated on each load. Without this, a browser can serve a stale
		# index.html from a previous deploy whose JS opens IndexedDB at an older
		# version, throwing a VersionError and leaving a blank page until the
		# user manually reloads.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
