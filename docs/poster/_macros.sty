%%%%%%% AF Macros %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\renewcommand{\AF}[1][F]{\ensuremath{\mathcal{#1}}\xspace}				% Abstract argumentation framework
\renewcommand{\arguments}{\ensuremath{\mathcal{A}}\xspace}				% Set of arguments
\renewcommand{\attacks}{\ensuremath{\mathcal{R}}\xspace}				% Attack relation
\newcommand{\nattacks}{\ensuremath{\centernot\attacks}}
\newcommand{\attackers}[2][\AF]{\ensuremath{#2^{-}_{#1}\xspace}}				% Attacker set
\newcommand{\attacked}[2][\AF]{\ensuremath{#2^{+}_{#1}\xspace}}				% Attacker set
\renewcommand{\AFcomplete}{\ensuremath{\AF=(\arguments,\attacks)}\xspace}		% Definition of an abstract argumentation framework
\newcommand{\allAFs}{\ensuremath{\mathbb{AF}}\xspace}
\newcommand{\allArgs}{\ensuremath{\mathbb{A}}\xspace}
\newcommand{\unattacked}[1][\AF]{\ensuremath{\mathfrak{US}(#1)}\xspace}
\newcommand{\SCCs}[1][\AF]{\ensuremath{\mathsf{SCCs}(#1)}\xspace}
\newcommand{\SCC}{\ensuremath{\mathsf{S}}\xspace}
\newcommand{\op}[1][\AF]{\ensuremath{\text{op}_{#1}}}
\newcommand{\sd}{\ensuremath{\mathtt{sd}}}                          % strong defense

\renewcommand{\afref}[2][F]{\ensuremath{\AF[#1]_{\ref{#2}}}\xspace}

\newcommand{\projection}[2][\AF]{\ensuremath{#1|_{#2}}\xspace}
\newcommand{\reduct}[2][\AF]{\ensuremath{{#1}^{#2}}\xspace}

\newcommand{\sem}{\ensuremath{\sigma}\xspace}
\newcommand{\ext}{\ensuremath{E}\xspace}
\newcommand{\set}{\ensuremath{S}\xspace}
\newcommand{\exts}[1]{\ensuremath{\sem(#1)}}
\newcommand{\chaf}[1][\AF]{\ensuremath{\Delta_{#1}}\xspace}

