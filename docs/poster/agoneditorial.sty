% agoneditorial.sty — an editorial style layer for the AgonProject poster.
% Flat, borderless sections on a warm off-white ground, a full-bleed blue
% masthead, an ochre accent and a Source Sans / Source Serif pairing.
% Built on tikzposter but deliberately bypassing its boxed block styles.
\ProvidesPackage{agoneditorial}

\RequirePackage{tikz}
\RequirePackage{tcolorbox}
\RequirePackage{varwidth}
\RequirePackage{letterspace}
\RequirePackage{calc}
\usetikzlibrary{shadows.blur}

% ---------------------------------------------------------------------------
% Palette
% ---------------------------------------------------------------------------
% Two brand colours carry every accent; the rest are neutrals.
\definecolor{aigblue}{RGB}{0,76,151}
\definecolor{aigyellow}{RGB}{210,149,81}
% Accent variants folded onto the two brand colours (kept as aliases so the
% call sites need not change): the ochre family becomes aigyellow, the blue
% variants become aigblue — bluetint a light tint of it so it stays legible
% as light text on the blue bands.
\colorlet{ochre}{aigyellow}
\colorlet{ochrelt}{aigyellow}
\colorlet{aigbluedeep}{aigblue}
\colorlet{bluetint}{aigblue!30!white}
% Neutrals (text, background, rules).
\definecolor{ink}{RGB}{23,35,59}
\definecolor{inksoft}{RGB}{58,69,95}
\definecolor{muted}{RGB}{87,97,122}
\definecolor{offwhite}{RGB}{246,243,238}
\definecolor{cream}{RGB}{239,228,209}
\definecolor{rulegrey}{RGB}{224,217,205}

% ---------------------------------------------------------------------------
% Colour + background styles
% ---------------------------------------------------------------------------
\definecolorstyle{editorialcolor}{}{
    \colorlet{backgroundcolor}{offwhite}
    \colorlet{framecolor}{offwhite}
    \colorlet{titlefgcolor}{white}
    \colorlet{titlebgcolor}{aigblue}
    \colorlet{blocktitlebgcolor}{offwhite}
    \colorlet{blocktitlefgcolor}{ink}
    \colorlet{blockbodybgcolor}{offwhite}
    \colorlet{blockbodyfgcolor}{ink}
    \colorlet{innerblocktitlebgcolor}{offwhite}
    \colorlet{innerblocktitlefgcolor}{ink}
    \colorlet{innerblockbodybgcolor}{offwhite}
    \colorlet{innerblockbodyfgcolor}{ink}
}

\definebackgroundstyle{editorialback}{
    \draw[draw=offwhite, fill=offwhite] (bottomleft) rectangle (topright);
}

% ---------------------------------------------------------------------------
% Masthead title style (full-bleed blue band, left identity, right logo chip)
% ---------------------------------------------------------------------------
\definetitlestyle{editorialtitle}{
    width=\paperwidth, roundedcorners=0, linewidth=0pt, innersep=0pt,
    titletotopverticalspace=0mm,
    % Vertical gap between the masthead and the first content row.
    titletoblockverticalspace=6mm
}{
    \begin{scope}
        \draw[draw=aigblue, fill=aigblue]
            (\titleposleft,\titleposbottom) rectangle (\titleposright,\titlepostop);
        % accent rule along the bottom edge of the masthead
        \draw[draw=aigyellow, fill=aigyellow]
            (\titleposleft,\titleposbottom) rectangle (\titleposright,\titleposbottom+0.7);
    \end{scope}
}

\makeatletter
% Title font hooks (override in main.tex via \renewcommand).
\newcommand{\agonTitleFont}{\sffamily\bfseries\scshape}
\newcommand{\agonSubtitleFont}{\itshape}
\settitle{%
    \hspace*{40mm}%
    \begin{minipage}[c]{0.56\linewidth}
        \vspace{2.2em}
        {\sffamily\bfseries\color{aigyellow}\fontsize{24}{28}\selectfont
            \textls[150]{ARTIFICIAL INTELLIGENCE GROUP \textbullet\ UNIVERSITY OF HAGEN}\par}
        \vspace{-0.50em}
        {{\agonTitleFont\color{white}\fontsize{150}{150}\selectfont \@title\par}}
        \vspace{0.7em}
        {{\color{bluetint}\agonSubtitleFont\fontsize{40}{46}\selectfont \@subtitle\par}}
        \vspace{2.2em}
    \end{minipage}%
    \hfill
    \begin{minipage}[c]{0.32\linewidth}
        \raggedleft%
        % Powered-by lockup, flush right so its edge mirrors the title's left margin.
    \makebox[\linewidth][r]{%
        \raisebox{-0.42\height}{\includegraphics[height=3cm]{figures/tweety-logo.png}}\hspace{18pt}%
        \begin{tabular}[c]{@{}l@{}}
            {\sffamily\bfseries\color{white}\fontsize{25}{28}\selectfont\textls[150]{POWERED BY}}\\[3pt]
            {\sffamily\bfseries\color{aigyellow}\fontsize{48}{52}\selectfont TweetyProject}\\[3pt]
            {\color{bluetint}\fontsize{26}{30}\selectfont reasoning libraries \& solvers}
        \end{tabular}%
    }%
        
    \end{minipage}%
    \hspace*{40mm}
}
% subtitle plumbing
\providecommand{\@subtitle}{}
\newcommand{\subtitle}[1]{\renewcommand{\@subtitle}{#1}}
\makeatother

% ---------------------------------------------------------------------------
% Flat, frameless block styles (content sits directly on the ground)
% ---------------------------------------------------------------------------
\defineblockstyle{flat}{
    titlewidthscale=1, bodywidthscale=1, titleleft, titleoffsetx=0pt, titleoffsety=0pt,
    bodyoffsetx=0mm, bodyoffsety=0mm, bodyverticalshift=0mm, roundedcorners=0,
    linewidth=0pt, titleinnersep=0mm, bodyinnersep=0mm
}{}

% Full-bleed footer band, pinned to the bottom edge of the page. Mirrors the
% masthead: an aigblue ground spanning the paper width with an aigyellow
% accent rule along its top edge. Drawn straight into tikzposter's master picture
% (whose bottomleft/topright coordinates and page clip are already in scope),
% as an overlay so it sits flush at the bottom without affecting the layout.
\newcommand{\footerband}[1]{%
    \begin{scope}[overlay]
        \node[anchor=south, minimum width=\textwidth, inner xsep=0pt,
              inner ysep=13mm, fill=aigblue, text=white] (fb)
            at (0,-0.5\textheight)
            {\begin{minipage}{0.9\textwidth}\centering #1\end{minipage}};
        \fill[aigyellow] (fb.north west) rectangle ([yshift=-6mm]fb.north east);
    \end{scope}%
}

% ---------------------------------------------------------------------------
% Editorial content helpers
% ---------------------------------------------------------------------------
% Small ochre uppercase kicker above a section.
\newcommand{\eyebrow}[1]{%
    {\sffamily\bfseries\color{ochre}\fontsize{24}{28}\selectfont
     \textls[200]{\MakeUppercase{#1}}\par}}

% Thin ink rule spanning the current width.
\newcommand{\sectionrule}{\par\vspace{0.2ex}{\color{ink}\rule{\linewidth}{2pt}}\par}

% Display heading / body shortcuts.
\newcommand{\dsp}{\sffamily}
\newcommand{\heading}[1]{{\sffamily\bfseries\color{ink}#1}}

% Highlight for scannable stats (counts, quantities) — bold ochre.
\newcommand{\stat}[1]{{\sffamily\bfseries\color{ochre}#1}}

% Framed screenshot: thin border + soft drop shadow.
\newcommand{\screenshot}[2][\linewidth]{%
    \tikz\node[inner sep=0pt, draw=rulegrey, line width=1.5pt,
        blur shadow={shadow blur steps=12, shadow xshift=0pt,
            shadow yshift=-7pt, shadow blur radius=12pt, shadow opacity=32}]
        {\includegraphics[width=#1]{#2}};%
}

% A titled screenshot panel: blue lead-in title, framed shot, muted caption.
\newcommand{\shotpanel}[4][\linewidth]{%
    {\sffamily\bfseries\color{aigblue}\fontsize{33}{37}\selectfont #2\par}
    \vspace{0.5em}\screenshot[#1]{#3}\par
    \vspace{0.5em}{\color{muted}\fontsize{23}{28}\selectfont #4\par}}

% Placeholder for a not-yet-captured screenshot: a framed grey panel of the
% same footprint as \shotpanel, so the layout can be finalised ahead of time.
\newcommand{\shotplaceholder}[2]{%
    {\sffamily\bfseries\color{aigblue}\fontsize{33}{37}\selectfont #1\par}
    \vspace{0.5em}%
    \tikz\node[inner sep=0pt, draw=rulegrey, line width=1.5pt, fill=cream,
        minimum width=0.9\linewidth, minimum height=0.458\linewidth,
        blur shadow={shadow blur steps=12, shadow xshift=0pt,
            shadow yshift=-7pt, shadow blur radius=12pt, shadow opacity=32}]
        {\sffamily\bfseries\color{muted}\fontsize{28}{32}\selectfont
         \faImage\ \ screenshot to come};%
    \par\vspace{0.5em}{\color{muted}\fontsize{23}{28}\selectfont #2\par}}

% One capability: title on the left, FontAwesome icon pushed to the right.
\newcommand{\featureitem}[3]{%
    \noindent{\sffamily\bfseries\color{ink}\fontsize{33}{37}\selectfont #1}%
    \hfill{\color{ochre}\fontsize{37}{37}\selectfont #2}\par
    \vspace{0.6em}{\color{muted}\fontsize{23}{28}\selectfont #3\par}}

% One formalism entry for the strip: bold blue abbreviation + description.
\newcommand{\formalism}[2]{%
    \noindent{\sffamily\bfseries\color{aigblue}\fontsize{30}{34}\selectfont #1}\hspace{0.5em}%
    {\color{inksoft}\fontsize{24}{29}\selectfont #2}\par}

% Cream callout with an ochre left border.
\newcommand{\callout}[1]{%
    \noindent\begin{tcolorbox}[colback=cream, colframe=ochre, boxrule=0pt,
        leftrule=6pt, arc=0pt, left=16pt, right=16pt, top=12pt, bottom=12pt,
        boxsep=0pt]{\color{inksoft}\fontsize{24}{30}\selectfont #1}\end{tcolorbox}}

% One row of the supported-semantics list: group label + description, ruled.
\newcommand{\semrow}[2]{%
    \par\vspace{0.12em}{\color{rulegrey}\rule{\linewidth}{1pt}}\par\vspace{0.12em}%
    \noindent\begin{minipage}[t]{0.29\linewidth}%
        {\sffamily\bfseries\color{ink}\fontsize{25}{30}\selectfont #1}%
    \end{minipage}\hfill\begin{minipage}[t]{0.7\linewidth}%
        {\color{inksoft}\fontsize{25}{30}\selectfont #2}%
    \end{minipage}\par}
