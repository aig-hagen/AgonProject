}

\newcommand{\leftlogo}{figures/tweety-logo.png}  % Replace with your actual file
\newcommand{\rightlogo}{figures/logoaig.png} % Replace with your actual file

\makeatletter

% ---------------------------------------------------------------------------
% Reusable title configuration (override these in the .tex, not here)
% ---------------------------------------------------------------------------
% Title font: default matches the historic \Huge. Instances can enlarge it via
%   \settitlefontsize{4cm}      % or \renewcommand{\postertitlefont}{...}
\providecommand{\postertitlefont}{\Huge}
\providecommand{\postersubtitlefont}{\LARGE\normalfont\itshape}
\newcommand{\settitlefontsize}[1]{%
    \renewcommand{\postertitlefont}{\fontsize{#1}{\dimexpr#1*6/5\relax}\selectfont}}

% Optional subtitle, rendered under the title. Empty by default.
\newcommand{\@postersubtitle}{}
\newcommand{\subtitle}[1]{\renewcommand{\@postersubtitle}{#1}}
\settitle{%
    \begin{minipage}{0.6\linewidth}
        \vspace*{0.9em}
		\color{titlefgcolor}
  	    \hspace*{1.5em}{\postertitlefont\bfseries\sc \@title \par}
		\ifx\@postersubtitle\@empty\else
			\vspace*{0.7em}
			\hspace*{1.5em}{\postersubtitlefont \@postersubtitle \par}
		\fi
		\ifx\@author\@empty\else
			\vspace*{0.9em}
			\hspace*{1.5em}{\huge \@author \par}
		\fi
		\vspace*{0.9em}
		\hspace*{1.5em}{\Large\itshape \@institute}
        \vspace{0.5em}
	\end{minipage}%
	\hfill
    \begin{minipage}{0.18\linewidth}
        \centering
        \includegraphics[scale=2]{\leftlogo}
    \end{minipage}
    \begin{minipage}{0.16\linewidth}
        \centering
        \begin{tcolorbox}[
            colback=white,     % background color
            colframe=gray!80,    % border color
            boxrule=0pt,         % border thickness
            arc=6mm,             % corner radius
            left=6pt, right=6pt, top=6pt, bottom=6pt, % padding inside box
            boxsep=2pt,          % space between box and content
            width=\linewidth,
            valign=center
        ]
        \includegraphics[scale=1.5]{\rightlogo}
        \end{tcolorbox}
    \end{minipage}
    \hspace*{1em}
}

%Blocks, 1 Blue and 1 Yellow Version for better variation and readability
\defineblockstyle{aigposterblockB}{
    titlewidthscale=1, bodywidthscale=1, titlecenter, titleoffsetx=0pt, titleoffsety=0pt, bodyoffsetx=0mm, bodyoffsety=15mm, bodyverticalshift=10mm, roundedcorners=5, linewidth=7.5pt, titleinnersep=6mm, bodyinnersep=1cm
}{%
\begin{scope}[line width=\blocklinewidth, rounded corners=\blockroundedcorners]
    \draw[color=aigblue, fill=blockbodybgcolor] (blockbody.south west) rectangle (blockbody.north east);
    \ifBlockHasTitle
        \draw[color=aigblue, fill=blocktitlebgcolor] (blocktitle.south west) rectangle (blocktitle.north east);
    \fi
\end{scope}
}


\defineblockstyle{aigposterblockY}{
    titlewidthscale=1, bodywidthscale=1,titlecenter, titleoffsetx=0pt, titleoffsety=0pt, bodyoffsetx=0mm, bodyoffsety=15mm, bodyverticalshift=10mm, roundedcorners=5, linewidth=7.5pt, titleinnersep=6mm, bodyinnersep=1cm
}{%
\begin{scope}[rounded corners=\blockroundedcorners,line width=\blocklinewidth]
    \draw[color=aigyellow, fill=aigyellow!30!white] (blockbody.south west) rectangle (blockbody.north east);
    \ifBlockHasTitle
        \draw[color=aigyellow, fill=aigyellow, text=aigblue] (blocktitle.south west) rectangle (blocktitle.north east);
    \fi
\end{scope}
}

\newcommand{\useblockstyleaigposterblockY}{\useblockstyle{aigposterblockY}}

\newcommand{\useblockstyleaigposterblockB}{\useblockstyle{aigposterblockB}}
% Some highlighting options:
\newcommand{\highlight}[1]{\colorbox{aigblue!10}{#1}}
\newcommand{\mathhighlight}[1]{\colorbox{aigblue!10}{$\displaystyle #1$}}
\newcommand{\darkhighlight}[1]{\colorbox{aigblue!20}{#1}}
\newcommand{\darkmathhighlight}[1]{\colorbox{aigblue!20}{$\displaystyle #1$}}
\newcommand{\yellowhighlight}[1]{\colorbox{aigyellow!30}{#1}}
\newcommand{\yellowmathhighlight}[1]{\colorbox{aigyellow!30}{$\displaystyle #1$}}


% ---------------------------------------------------------------------------
% Reusable content helpers
% ---------------------------------------------------------------------------
% Inner block with the AIG-blue title bar and a white body. Use instead of
% repeating the four \colorlet lines. Colours are scoped locally.
\newcommand{\accentinnerblock}[2]{%
    \begingroup
    \colorlet{innerblocktitlebgcolor}{aigblue}%
    \colorlet{innerblocktitlefgcolor}{white}%
    \colorlet{innerblockbodybgcolor}{white}%
    \colorlet{innerblockbodyfgcolor}{black}%
    \innerblock{#1}{#2}%
    \endgroup}

% Inner block with a yellow title bar and a light-yellow body (accent variant).
\newcommand{\accentinnerblockY}[2]{%
    \begingroup
    \colorlet{innerblocktitlebgcolor}{aigyellow}%
    \colorlet{innerblocktitlefgcolor}{white}%
    \colorlet{innerblockbodybgcolor}{aigyellow!30}%
    \colorlet{innerblockbodyfgcolor}{black}%
    \innerblock{#1}{#2}%
    \endgroup}

% Full-width yellow highlighted callout box with a little internal padding.
\newcommand{\yellowcallout}[1]{%
    \yellowhighlight{\parbox{0.96\linewidth}{\vspace{0.4ex}#1\vspace{0.4ex}}}}

% Framed screenshot: thin light border plus a soft drop shadow, so UI
% screenshots read as artifacts instead of dissolving into the block
% background. Usage: \screenshot[<width>]{<file>} (width defaults to \linewidth).
\usetikzlibrary{shadows.blur}
\newcommand{\screenshot}[2][\linewidth]{%
    \tikz\node[inner sep=0pt, draw=black!15, line width=1pt,
        blur shadow={shadow blur steps=10, shadow xshift=0pt,
            shadow yshift=-5pt, shadow blur radius=8pt, shadow opacity=35}]
        {\includegraphics[width=#1]{#2}};%
}

% One feature: a coloured lead-in title followed by descriptive text. Use as
% the text half of an integrated feature/screenshot row.
\newcommand{\featuretext}[2]{%
    {\Large\bfseries\color{aigblue}#1}\par\vspace{0.4ex}#2\par}

% Colour-styled blocks, so an alternating blue/yellow grid stays readable in
% the .tex without manual \useblockstyle toggling. The style change is scoped.
\newcommand{\blueblock}[2]{\begingroup\useblockstyle{aigposterblockB}\block{#1}{#2}\endgroup}
\newcommand{\yellowblock}[2]{\begingroup\useblockstyle{aigposterblockY}\block{#1}{#2}\endgroup}

% A screenshot panel: a framed screenshot plus a one-line caption, sized to the
% block. Use as the body of a small, single-purpose screenshot block.
\newcommand{\shotpanel}[3][0.96\linewidth]{%
    \centering\screenshot[#1]{#2}\par\vspace{0.5ex}%
    {\footnotesize #3}\par}
