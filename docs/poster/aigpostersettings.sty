%Title with one Logo

\definetitlestyle{aigpostertitle1}{width=\paperwidth, roundedcorners=0, linewidth=5pt, innersep=5pt,titletotopverticalspace=0mm, titletoblockverticalspace=30mm
}{
\begin{scope}[line width=0pt, rounded corners=\titleroundedcorners]
	\draw[color=blocktitlebgcolor, fill=titlebgcolor]
