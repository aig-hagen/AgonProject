%%%%%%% AF Macros %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\renewcommand{\AF}[1][AF]{\ensuremath{\mathsf{#1}}\xspace}				% Abstract argumentation framework
%\renewcommand{\arguments}{\ensuremath{\mathsf{A}}\xspace}				% Set of arguments
\RenewDocumentCommand { \arguments } { O{} } {
    \IfBlankTF{#1}{%
        \ensuremath{\mathsf{A}}\xspace
    }{%
        \ensuremath{\mathsf{A}_{\AF[#1]}}\xspace
    }
}
%\renewcommand{\attacks}{\ensuremath{\mathsf{R}}\xspace}				% Attack relation
\RenewDocumentCommand { \attacks } { O{} } {
    \IfBlankTF{#1}{%
        \ensuremath{\mathsf{R}}\xspace
    }{%
        \ensuremath{\mathsf{R}_{\AF[#1]}}\xspace
    }
}
\newcommand{\nattacks}{\ensuremath{\centernot\attacks}}
\NewDocumentCommand { \attackers } { O{} m } {
    \IfBlankTF{#1}{%
        \ensuremath{#2^{-}}\xspace
    }{%
        \ensuremath{#2^{-}_{\AF[#1]}}\xspace
    }
}
\NewDocumentCommand { \attacked } { O{} m } {
    \IfBlankTF{#1}{%
        \ensuremath{#2^{+}}\xspace
    }{%
        \ensuremath{#2^{+}_{\AF[#1]}}\xspace
    }
}
%\newcommand{\attackers}[2][\AF]{\ensuremath{#2^{-}_{#1}\xspace}}				% Attacker set
%\newcommand{\attacked}[2][\AF]{\ensuremath{#2^{+}_{#1}\xspace}}				% Attacker set
\RenewDocumentCommand {\AFcomplete} { O{} } {
    \IfBlankTF{#1}{%
        \ensuremath{\AF=(\arguments,\attacks)}\xspace
    }{%
        \ensuremath{\AF[#1]=(\arguments[#1],\attacks[#1])}\xspace
    }
}
%\renewcommand{\AFcomplete}{\ensuremath{\AF=(\arguments,\attacks)}\xspace}		% Definition of an abstract argumentation framework
\newcommand{\allAFs}{\ensuremath{\mathbb{AF}}\xspace}
\newcommand{\allArgs}{\ensuremath{\mathbb{A}}\xspace}
\newcommand{\unattacked}[1][\AF]{\ensuremath{\mathfrak{US}(#1)}\xspace}
